# Copy these connection values from your online MySQL-compatible provider.
# Add them through Streamlit Community Cloud Advanced settings. 
# Do not rename this file to secrets.toml and commit it to GitHub.

ECOMMERCE_DB_HOST = "your-cloud-database-host"
ECOMMERCE_DB_PORT = "4000"
ECOMMERCE_DB_NAME = "ecommerce_ab_test"
ECOMMERCE_DB_USER = "your-cloud-database-user"
ECOMMERCE_DB_PASSWORD = "your-cloud-database-password"
ECOMMERCE_DB_SSL = "true"

# TiDB on Streamlit Community Cloud normally uses this Linux system CA bundle.
ECOMMERCE_DB_SSL_CA = "/etc/ssl/certs/ca-certificates.crt"
